# Server Configuration
# Backend server port (development only)
BACKEND_PORT=3001
# Frontend development server port (development only)
FRONTEND_PORT=3000
# Production server port (used by both frontend and backend in production)
PORT=3000
NODE_ENV=development

# Deployment Mode Configuration
# Options: "fullstack" or "frontend-only"
# - fullstack: Run both frontend and backend services (default)
# - frontend-only: Run only frontend, crypto operations performed client-side
DEPLOYMENT_MODE=fullstack

# EULA Agreement Configuration
# Controls whether the End User License Agreement system is enabled
# When set to true, users must accept the EULA before accessing encryption/decryption functionality
# When set to false, the EULA prompt is disabled and all features are immediately available
REQUIRE_EULA_AGREEMENT=false